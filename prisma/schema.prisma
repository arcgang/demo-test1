generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MarketConfig {
  id                 String   @id @default(uuid()) @db.Uuid
  marketCode         String   @unique @map("market_code") @db.VarChar(8)
  marketName         String   @map("market_name") @db.VarChar(100)
  localeCode         String   @map("locale_code") @db.VarChar(16)
  currencyCode       String   @map("currency_code") @db.VarChar(8)
  taxLabel           String   @map("tax_label") @db.VarChar(32)
  mobileMoneyEnabled Boolean  @default(false) @map("mobile_money_enabled")
  cardPaymentEnabled Boolean  @default(true) @map("card_payment_enabled")
  liteModeDefault    Boolean  @default(false) @map("lite_mode_default")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  productCaches     ProductCache[]
  customerSessions  CustomerSession[]
  carts             Cart[]
  financeQuotes     FinanceQuote[]
  tradeInQuotes     TradeInQuote[]
  verificationCases VerificationCase[]
  shopOrders        ShopOrder[]

  @@map("market_config")
}

model ProductCache {
  id                 String   @id @default(uuid()) @db.Uuid
  productId          String   @unique @map("product_id") @db.VarChar(64)
  marketCode         String   @map("market_code") @db.VarChar(8)
  productType        String   @map("product_type") @db.VarChar(32)
  name               String   @db.VarChar(255)
  priceOnceOff       Decimal  @default(0) @map("price_once_off") @db.Decimal(12, 2)
  priceRecurring     Decimal  @default(0) @map("price_recurring") @db.Decimal(12, 2)
  availabilityStatus String   @map("availability_status") @db.VarChar(32)
  metadataJson       Json     @map("metadata_json") @db.JsonB
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  market MarketConfig @relation(fields: [marketCode], references: [marketCode])

  @@map("product_cache")
}

model CustomerSession {
  id              String   @id @default(uuid()) @db.Uuid
  sessionId       String   @unique @map("session_id")
  customerId      String?  @map("customer_id")
  lineId          String?  @map("line_id")
  isAuthenticated Boolean  @default(false) @map("is_authenticated")
  marketCode      String   @map("market_code") @db.VarChar(8)
  expiresAt       DateTime @map("expires_at") @db.Timestamptz
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  market             MarketConfig        @relation(fields: [marketCode], references: [marketCode])
  carts              Cart[]
  eligibilityResults EligibilityResult[]
  financeQuotes      FinanceQuote[]
  tradeInQuotes      TradeInQuote[]
  verificationCases  VerificationCase[]
  shopOrders         ShopOrder[]
  consentRecords     ConsentRecord[]
  auditEvents        AuditEvent[]

  @@map("customer_session")
}

model Cart {
  id                String   @id @default(uuid()) @db.Uuid
  sessionId         String   @map("session_id")
  marketCode        String   @map("market_code") @db.VarChar(8)
  status            String   @db.VarChar(32)
  currencyCode      String   @map("currency_code") @db.VarChar(8)
  onceOffSubtotal   Decimal  @default(0) @map("once_off_subtotal") @db.Decimal(12, 2)
  recurringSubtotal Decimal  @default(0) @map("recurring_subtotal") @db.Decimal(12, 2)
  taxAmount         Decimal  @default(0) @map("tax_amount") @db.Decimal(12, 2)
  creditAmount      Decimal  @default(0) @map("credit_amount") @db.Decimal(12, 2)
  payableNow        Decimal  @default(0) @map("payable_now") @db.Decimal(12, 2)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  session         CustomerSession  @relation(fields: [sessionId], references: [sessionId])
  market          MarketConfig     @relation(fields: [marketCode], references: [marketCode])
  cartItems       CartItem[]
  paymentAttempts PaymentAttempt[]
  shopOrders      ShopOrder[]

  @@map("cart")
}

model CartItem {
  id              String   @id @default(uuid()) @db.Uuid
  cartId          String   @map("cart_id") @db.Uuid
  lineType        String   @map("line_type") @db.VarChar(32)
  referenceId     String?  @map("reference_id") @db.VarChar(64)
  productId       String?  @map("product_id") @db.VarChar(64)
  displayName     String   @map("display_name") @db.VarChar(255)
  quantity        Int      @default(1)
  onceOffAmount   Decimal  @default(0) @map("once_off_amount") @db.Decimal(12, 2)
  recurringAmount Decimal  @default(0) @map("recurring_amount") @db.Decimal(12, 2)
  metadataJson    Json     @map("metadata_json") @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@map("cart_item")
}

model EligibilityResult {
  id                  String   @id @default(uuid()) @db.Uuid
  sessionId           String   @map("session_id")
  customerId          String   @map("customer_id")
  lineId              String   @map("line_id")
  targetProductId     String   @map("target_product_id")
  eligibilityStatus   String   @map("eligibility_status") @db.VarChar(32)
  reasonCode          String?  @map("reason_code") @db.VarChar(64)
  compatiblePlansJson Json     @map("compatible_plans_json") @db.JsonB
  inventoryStatus     String?  @map("inventory_status") @db.VarChar(32)
  evaluatedAt         DateTime @default(now()) @map("evaluated_at") @db.Timestamptz
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz

  session CustomerSession @relation(fields: [sessionId], references: [sessionId])

  @@map("eligibility_result")
}

model FinanceQuote {
  id          String    @id @default(uuid()) @db.Uuid
  sessionId   String    @map("session_id")
  customerId  String    @map("customer_id")
  productId   String    @map("product_id")
  marketCode  String    @map("market_code") @db.VarChar(8)
  quoteStatus String    @map("quote_status") @db.VarChar(32)
  optionsJson Json      @map("options_json") @db.JsonB
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  session CustomerSession @relation(fields: [sessionId], references: [sessionId])
  market  MarketConfig    @relation(fields: [marketCode], references: [marketCode])

  @@map("finance_quote")
}

model TradeInQuote {
  id                String    @id @default(uuid()) @db.Uuid
  sessionId         String    @map("session_id")
  customerId        String    @map("customer_id")
  marketCode        String    @map("market_code") @db.VarChar(8)
  devicePayloadJson Json      @map("device_payload_json") @db.JsonB
  quoteStatus       String    @map("quote_status") @db.VarChar(32)
  estimatedCredit   Decimal   @map("estimated_credit") @db.Decimal(12, 2)
  expiresAt         DateTime? @map("expires_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz

  session CustomerSession @relation(fields: [sessionId], references: [sessionId])
  market  MarketConfig    @relation(fields: [marketCode], references: [marketCode])

  @@map("trade_in_quote")
}

model VerificationCase {
  id                    String   @id @default(uuid()) @db.Uuid
  sessionId             String   @map("session_id")
  marketCode            String   @map("market_code") @db.VarChar(8)
  productType           String   @map("product_type") @db.VarChar(32)
  customerPayloadJson   Json     @map("customer_payload_json") @db.JsonB
  portingPayloadJson    Json?    @map("porting_payload_json") @db.JsonB
  verificationStatus    String   @map("verification_status") @db.VarChar(32)
  activationEligible    Boolean  @default(false) @map("activation_eligible")
  verificationReference String?  @map("verification_reference") @db.VarChar(128)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz

  session CustomerSession @relation(fields: [sessionId], references: [sessionId])
  market  MarketConfig    @relation(fields: [marketCode], references: [marketCode])

  @@map("verification_case")
}

model PaymentAttempt {
  id                  String   @id @default(uuid()) @db.Uuid
  cartId              String   @map("cart_id") @db.Uuid
  paymentMethod       String   @map("payment_method") @db.VarChar(32)
  providerName        String   @map("provider_name") @db.VarChar(64)
  providerReference   String?  @map("provider_reference") @db.VarChar(128)
  tokenReference      String?  @map("token_reference") @db.VarChar(128)
  paymentStatus       String   @map("payment_status") @db.VarChar(32)
  amount              Decimal  @map("amount") @db.Decimal(12, 2)
  currencyCode        String   @map("currency_code") @db.VarChar(8)
  callbackPayloadJson Json?    @map("callback_payload_json") @db.JsonB
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz

  cart Cart @relation(fields: [cartId], references: [id])

  @@map("payment_attempt")
}

model ShopOrder {
  id                     String   @id @default(uuid()) @db.Uuid
  cartId                 String   @map("cart_id") @db.Uuid
  sessionId              String   @map("session_id")
  customerId             String?  @map("customer_id")
  marketCode             String   @map("market_code") @db.VarChar(8)
  externalOrderReference String?  @map("external_order_reference") @db.VarChar(128)
  orderStatus            String   @map("order_status") @db.VarChar(32)
  paymentStatus          String   @map("payment_status") @db.VarChar(32)
  verificationStatus     String?  @map("verification_status") @db.VarChar(32)
  activationStatus       String?  @map("activation_status") @db.VarChar(32)
  totalAmount            Decimal  @map("total_amount") @db.Decimal(12, 2)
  currencyCode           String   @map("currency_code") @db.VarChar(8)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz

  cart             Cart              @relation(fields: [cartId], references: [id])
  session          CustomerSession   @relation(fields: [sessionId], references: [sessionId])
  market           MarketConfig      @relation(fields: [marketCode], references: [marketCode])
  orderItems       OrderItem[]
  activationRecord ActivationStatus? @relation("OrderActivationStatus")
  auditEvents      AuditEvent[]

  @@map("shop_order")
}

model OrderItem {
  id              String   @id @default(uuid()) @db.Uuid
  orderId         String   @map("order_id") @db.Uuid
  lineType        String   @map("line_type") @db.VarChar(32)
  productId       String?  @map("product_id") @db.VarChar(64)
  displayName     String   @map("display_name") @db.VarChar(255)
  quantity        Int      @default(1)
  onceOffAmount   Decimal  @default(0) @map("once_off_amount") @db.Decimal(12, 2)
  recurringAmount Decimal  @default(0) @map("recurring_amount") @db.Decimal(12, 2)
  metadataJson    Json     @map("metadata_json") @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  order ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_item")
}

model ActivationStatus {
  id                   String   @id @default(uuid()) @db.Uuid
  orderId              String   @unique @map("order_id") @db.Uuid
  activationState      String   @map("activation_state") @db.VarChar(32)
  esimReference        String?  @map("esim_reference") @db.VarChar(128)
  esimQrPayload        String?  @map("esim_qr_payload")
  milestonePayloadJson Json     @map("milestone_payload_json") @db.JsonB
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz

  order ShopOrder @relation("OrderActivationStatus", fields: [orderId], references: [id])

  @@map("activation_status")
}

model ConsentRecord {
  id            String   @id @default(uuid()) @db.Uuid
  sessionId     String   @map("session_id")
  customerId    String?  @map("customer_id")
  purposeCode   String   @map("purpose_code") @db.VarChar(32)
  granted       Boolean
  sourceChannel String   @default("WEB") @map("source_channel") @db.VarChar(32)
  recordedAt    DateTime @default(now()) @map("recorded_at") @db.Timestamptz
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  session CustomerSession @relation(fields: [sessionId], references: [sessionId])

  @@map("consent_record")
}

model AuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  sessionId     String?  @map("session_id")
  orderId       String?  @map("order_id") @db.Uuid
  eventType     String   @map("event_type") @db.VarChar(64)
  eventCategory String   @map("event_category") @db.VarChar(64)
  actorType     String   @map("actor_type") @db.VarChar(32)
  actorId       String?  @map("actor_id") @db.VarChar(64)
  payloadJson   Json     @map("payload_json") @db.JsonB
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  session CustomerSession? @relation(fields: [sessionId], references: [sessionId])
  order   ShopOrder?       @relation(fields: [orderId], references: [id])

  @@map("audit_event")
}
